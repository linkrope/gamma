root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.d]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

# Keep ordinary code comfortably below the dscanner hard limit without
# needlessly breaking established 100-column lines.
dfmt_soft_max_line_length = 100
dfmt_brace_style = allman
dfmt_align_switch_statements = false
dfmt_space_after_cast = true
dfmt_selective_import_space = true
dfmt_space_before_named_arg_colon = false
dfmt_keep_line_breaks = true
dfmt_reflow_property_chains = false
