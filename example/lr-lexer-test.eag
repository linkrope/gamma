// test grammar for LR lexer longest match
// with left-recursive starred nonterminal

S = .

Op = '<' | '<=' | 'if'.

S <+ : S>:
    Op Op Op id Op.

Op:
      '<'
    | '<='
    | 'if'.

letter = 'i' | 'f' | 'x'.

letter:
      'i'
    | 'f'
    | 'x'.

id* = letter | id letter.

id*:
      id letter
    | letter.
